# Keep real values only in .env or in server-side hosting environment variables.
# .env is excluded from Git.
MOTHERDUCK_TOKEN=

# Optional. Users bring their own OpenAI key on the landing page; this server key is only the fallback for requests
# without one (and for admin scripts that call OpenAI directly). Leave it unset to require every user to supply a key.
# Only OPEN_AI_KEY is read; the generic OPENAI_API_KEY variable is ignored on purpose.
OPEN_AI_KEY=
OPEN_AI_MODEL=gpt-4o

# Optional observability. Configure both values or neither.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: only needed for a region-specific Langfuse deployment (e.g. https://jp.cloud.langfuse.com).
# Defaults to https://cloud.langfuse.com when unset.
LANGFUSE_BASE_URL=
# Optional, dev-only: true/1/yes sends the raw question and each node's raw output (SQL,
# answer text, etc.) to Langfuse's Input/Output fields, not just hashes/counts in metadata.
# Defaults to false (redacted-only) — do not enable in a shared/production environment.
LANGFUSE_VERBOSE_TRACING=

# Optional document-RAG branch (no corpus is wired in yet). Configure the URL and key together.
QDRANT_API_KEY=
QDRANT_API_URL=
# Enables merchant-category matching (and document embedding once a corpus exists).
OPEN_AI_EMBEDDING_MODEL=

# Optional: comma-separated frontend origins allowed to call /api/chat cross-origin.
# Defaults to common local dev servers (localhost:3000, localhost:5173) when unset.
CORS_ALLOWED_ORIGINS=