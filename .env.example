# Keep real values only in .env or in server-side hosting environment variables.
# .env is excluded from Git.
MOTHERDUCK_TOKEN=

# The backend prefers OPEN_AI_KEY. OPENAI_API_KEY is supported only as a hosting fallback.
OPEN_AI_KEY=
OPEN_AI_MODEL=gpt-4o
OPENAI_API_KEY=

# Optional durable conversation store. Configure both values or neither.
SUPABASE_URL=
SUPABASE_KEY=

# Optional observability. Configure both values or neither.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional public complaint-RAG branch. Configure all three values together to enable retrieval.
QDRANT_API_KEY=
QDRANT_API_URL=
# Required only for complaints RAG ingestion.
OPEN_AI_EMBEDDING_MODEL=
